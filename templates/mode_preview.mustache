{{!
    @template local_ltiaccountmerge/mode_preview

    Effective provisioning mode per published resource at a chosen instant.

    Context variables required for this template:
    * instant - Human readable instant
    * hasrows - Whether any resource exists
    * rows - Array of rows: toolname, coursename, learner, learnerpolicy, instructor, instructorpolicy, corelearner, coreinstructor

    Example context (json):
    {
        "instant": "1 January 2027, 08:00:00 (Europe/Berlin)",
        "hasrows": true,
        "rows": [{
            "toolname": "Tool", "coursename": "Course", "learner": "Automatic", "learnerpolicy": "Exam week",
            "instructor": "Not governed", "instructorpolicy": "-", "corelearner": "Prompt", "coreinstructor": "Prompt"
        }]
    }
}}
<div class="local-ltiam-preview my-3">
    <p>{{#str}}preview_at, local_ltiaccountmerge, {{instant}}{{/str}}</p>
    {{#hasrows}}
    <div class="table-responsive">
        <table class="generaltable table table-sm">
            <caption>{{#str}}preview_caption, local_ltiaccountmerge{{/str}}</caption>
            <thead>
                <tr>
                    <th scope="col">{{#str}}resource, local_ltiaccountmerge{{/str}}</th>
                    <th scope="col">{{#str}}effective_learner, local_ltiaccountmerge{{/str}}</th>
                    <th scope="col">{{#str}}effective_instructor, local_ltiaccountmerge{{/str}}</th>
                    <th scope="col">{{#str}}current_core, local_ltiaccountmerge{{/str}}</th>
                </tr>
            </thead>
            <tbody>
                {{#rows}}
                <tr>
                    <th scope="row">{{toolname}}<br><small class="text-muted">{{coursename}}</small></th>
                    <td>{{learner}}<br><small class="text-muted">{{learnerpolicy}}</small></td>
                    <td>{{instructor}}<br><small class="text-muted">{{instructorpolicy}}</small></td>
                    <td>{{corelearner}} / {{coreinstructor}}</td>
                </tr>
                {{/rows}}
            </tbody>
        </table>
    </div>
    {{/hasrows}}
    {{^hasrows}}
    <p class="alert alert-info" role="status">{{#str}}noresources, local_ltiaccountmerge{{/str}}</p>
    {{/hasrows}}
</div>
