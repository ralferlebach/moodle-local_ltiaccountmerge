{{!
    @template local_ltiaccountmerge/error_page

    Branded error page of the error catalogue. The body is already sanitised HTML.

    Context variables required for this template:
    * title - Heading text
    * body - Sanitised HTML body
    * brandname - Brand name (escaped)
    * logourl - Logo URL or empty
    * hassupport, support - Support contact text
    * hassupportid, supportid - Support ID
    * code - Error code

    Example context (json):
    {
        "title": "Account already linked",
        "body": "<p>This identity is already linked.</p>",
        "brandname": "Example University",
        "logourl": "",
        "hassupport": true,
        "support": "helpdesk@example.org",
        "hassupportid": true,
        "supportid": "LTIAM-0123ABCD",
        "code": "identitybound"
    }
}}
<section class="local-ltiam-error card my-3" aria-labelledby="ltiam-error-title" data-ltiam-code="{{code}}">
    <div class="card-body">
        {{#logourl}}<img class="mb-3" src="{{logourl}}" alt="{{brandname}}" style="max-height:4rem">{{/logourl}}
        {{^logourl}}<p class="text-muted mb-2">{{brandname}}</p>{{/logourl}}
        <h2 id="ltiam-error-title" class="h3" tabindex="-1">{{title}}</h2>
        <div role="alert" class="ltiam-error-body">{{{body}}}</div>
        {{#hassupportid}}
        <p class="mt-3"><span class="font-weight-bold">{{#str}}supportid, local_ltiaccountmerge{{/str}}</span>
            <code class="ltiam-supportid">{{supportid}}</code></p>
        {{/hassupportid}}
        {{#hassupport}}
        <p>{{#str}}supportcontact, local_ltiaccountmerge{{/str}} {{support}}</p>
        {{/hassupport}}
    </div>
</section>
